# Copy this file to .env and replace every <...> placeholder before `docker compose up --build`.
# .env is ignored by git; never commit real passwords.
#
# Password rules for this setup:
# - SQL Server: at least 8 characters with characters from at least three of: upper case, lower case, digits,
#   symbols (e.g. Kitap-2026-Parola). SQL Server refuses weaker passwords and the container does not start.
# - Do not use ' " ; $ or ` in any password: they break the SQL script, the connection string or compose.

# SQL Server administrator (sa). Used only by the mssql container and the one-off db-init service.
MSSQL_SA_PASSWORD=<sa-parolasi>

# Password of the application login bildiri_app, which the API uses. Same complexity rules as above.
APP_DB_PASSWORD=<uygulama-veritabani-parolasi>

# RabbitMQ user for the API and the management UI (http://localhost:15672). The guest account is not used.
RABBITMQ_USER=bildiri
RABBITMQ_PASSWORD=<rabbitmq-parolasi>

# Optional: requests per minute and client for uploads and generation (defaults 10 and 20).
# The end-to-end tests against this setup need more: set both to 1000 before `npm run test:e2e:docker`.
# UPLOAD_RATE_LIMIT_PER_MINUTE=10
# GENERATE_RATE_LIMIT_PER_MINUTE=20
