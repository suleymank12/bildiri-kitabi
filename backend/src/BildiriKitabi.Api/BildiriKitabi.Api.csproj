<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Lets `dotnet user-secrets` hold a local connection string in Development instead of appsettings. -->
    <UserSecretsId>bildiri-kitabi-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BildiriKitabi.Infrastructure\BildiriKitabi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BildiriKitabi.IntegrationTests" />
  </ItemGroup>

</Project>
